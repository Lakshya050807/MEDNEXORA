PORT=5000
# Local default. Set NODE_ENV=production in the production environment.
NODE_ENV=development
# Deployment lane. For Railway staging use APP_ENV=staging with NODE_ENV=production.
APP_ENV=development
# Public-launch controls are opt-in in production. Leave them unset or false until
# the owner has completed and approved every page listed in PUBLIC_LAUNCH_READINESS.md.
# Production startup rejects enabling either feature unless all six page approvals are true.
# Local development/test defaults remain enabled when these variables are omitted.
# PUBLIC_BETA_REGISTRATION_ENABLED=false
# PUBLIC_BETA_PAID_PURCHASES_ENABLED=false
# PUBLIC_ABOUT_PAGE_APPROVED=false
# PUBLIC_CONTACT_PAGE_APPROVED=false
# PUBLIC_FAQ_PAGE_APPROVED=false
# PUBLIC_PRIVACY_POLICY_APPROVED=false
# PUBLIC_TERMS_PAGE_APPROVED=false
# PUBLIC_REFUND_POLICY_APPROVED=false
# Password reset email delivery is opt-in and independent from public registration.
PASSWORD_RESET_EMAIL_ENABLED=false
# Password reset delivery uses Resend. Keep the feature disabled until approved.
# Sensitive backend-only key. Never place this variable in frontend/Vercel build settings.
RESEND_API_KEY=
# Local MongoDB default. Production must use a TLS-enabled URI and restricted DB user.
MONGODB_URI=mongodb://127.0.0.1:27017/nursing_education
# Temporary production catalogue audit only. Use a separate Atlas user with read-only database access.
# This variable is not used by normal application startup and must never contain a write-capable account.
CATALOGUE_AUDIT_MONGODB_URI=
# Sensitive backend runtime secret: use a unique random value with at least 32 bytes.
SESSION_SECRET=replace-with-a-unique-secret-of-at-least-32-bytes
# Optional backend runtime setting: integer days from 1 to 30 (default 7).
SESSION_MAX_AGE_DAYS=7
# Frontend origin. Production must be the exact HTTPS origin, without a path.
APP_ORIGIN=http://localhost:5173
# Backend runtime: 0 locally. On Railway, set TRUST_PROXY=1 for its single HTTPS ingress proxy;
# for other hosts, use only the exact trusted proxy IP/CIDRs or built-in ranges.
TRUST_PROXY=0
# Optional: origin of a dedicated private file service. References must be under /private/.
# Backend runtime, HTTPS only in production; not a secret.
PRIVATE_STORAGE_ORIGIN=
# Backend runtime. Leave empty for the local development default. Production requires an
# explicit absolute path to a mounted persistent directory outside frontend public/dist.
PRIVATE_STORAGE_DIR=
# Backend runtime. Staging requires APP_ENV=staging and RAZORPAY_MODE=test;
# production requires APP_ENV=production, RAZORPAY_MODE=live, and live credentials.
RAZORPAY_MODE=test
# Backend runtime. Production requires a live key ID; key ID is not secret but keep it server-side.
RAZORPAY_KEY_ID=
# Sensitive backend runtime credential. Never put in frontend variables/build output.
RAZORPAY_KEY_SECRET=
# Sensitive backend runtime credential required for webhook verification in production.
RAZORPAY_WEBHOOK_SECRET=

