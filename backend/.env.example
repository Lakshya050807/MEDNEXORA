PORT=5000
# Local default. Set NODE_ENV=production in the production environment.
NODE_ENV=development
# Deployment lane. For Railway staging use APP_ENV=staging with NODE_ENV=production.
APP_ENV=development
# Local MongoDB default. Production must use a TLS-enabled URI and restricted DB user.
MONGODB_URI=mongodb://127.0.0.1:27017/nursing_education
# Sensitive backend runtime secret: use a unique random value with at least 32 bytes.
SESSION_SECRET=replace-with-a-unique-secret-of-at-least-32-bytes
# Optional backend runtime setting: integer days from 1 to 30 (default 7).
SESSION_MAX_AGE_DAYS=7
# Frontend origin. Production must be the exact HTTPS origin, without a path.
APP_ORIGIN=http://localhost:5173
# Backend runtime: 0 by default; configure only the actual trusted proxy IP/CIDRs.
TRUST_PROXY=0
# Optional: origin of a dedicated private file service. References must be under /private/.
# Backend runtime, HTTPS only in production; not a secret.
PRIVATE_STORAGE_ORIGIN=
# Backend runtime. Leave empty for the local development default. Production requires an
# explicit absolute path to a mounted persistent directory outside frontend public/dist.
PRIVATE_STORAGE_DIR=
# Backend runtime. Local default is test. Staging must explicitly set test; production must explicitly set live.
RAZORPAY_MODE=test
# Backend runtime. Production requires a live key ID; key ID is not secret but keep it server-side.
RAZORPAY_KEY_ID=
# Sensitive backend runtime credential. Never put in frontend variables/build output.
RAZORPAY_KEY_SECRET=
# Sensitive backend runtime credential required for webhook verification in production.
RAZORPAY_WEBHOOK_SECRET=

