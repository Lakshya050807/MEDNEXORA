# Optional development-only API origin for the Vite proxy; not used by the production bundle.
# Format: origin URL, e.g. http://127.0.0.1:5000. Not sensitive.
API_PROXY_TARGET=http://127.0.0.1:5000

# Frontend build-time SEO setting. Set to the confirmed HTTPS site origin (no path) before building.
# Not sensitive. A sitemap is omitted when this is unset.
PUBLIC_SITE_URL=https://your-confirmed-domain.example
